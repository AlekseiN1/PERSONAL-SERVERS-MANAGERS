# Скопируй в .env и заполни. .env в .gitignore — не коммить секреты.

# Логин/пароль Portainer (общие на всех серверах). Аутентификация: POST /api/auth -> JWT.
# Per-server override (если где-то свои креды) — поля servers.username / servers.password.
PORTAINER_USER=admin
PORTAINER_PASSWORD=changeme

# MongoDB. Где запущен Mongo (локально / в одной из VM) — уточни под свою инфраструктуру.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=servers_manager

# Порт Portainer HTTPS по умолчанию (можно переопределить в документе сервера).
DEFAULT_PORTAINER_PORT=9443

# Главный (эталонный) сервер для сравнения/нормализации/распространения стеков (★ в UI).
MAIN_SERVER_NAME=Nitarti-15-f375154914

# Проверять TLS-серты Portainer. false для self-signed во внутренней сети.
PORTAINER_VERIFY_TLS=false

# Локальный запуск через `python run.py`.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false      # авто-перезапуск при изменении файлов (для разработки)
OPEN_BROWSER=true     # открывать браузер при старте
