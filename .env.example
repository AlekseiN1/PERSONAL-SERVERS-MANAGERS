# Copy to .env and fill in. .env is in .gitignore — do not commit secrets.

# Portainer login/password (shared across all servers). Auth: POST /api/auth -> JWT.
# Per-server override (if some servers use different creds) — servers.username / servers.password fields.
PORTAINER_USER=admin
PORTAINER_PASSWORD=changeme

# MongoDB. Where Mongo runs (locally / on one of the VMs) — adjust to your infra.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=servers_manager

# Default Portainer HTTPS port (can be overridden in the server document).
DEFAULT_PORTAINER_PORT=9443

# Main (reference) server used for compare/normalize/propagate (★ in the UI).
MAIN_SERVER_NAME=Nitarti-15-f375154914

# Verify Portainer TLS certs. false for self-signed certs on an internal network.
PORTAINER_VERIFY_TLS=false

# Where stack compose+env backups are saved (relative paths resolve against the
# current working directory the app was started from — the project root, normally).
BACKUP_DIR=backups

# Local run via `python run.py`.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false      # auto-reload on file changes (for development)
OPEN_BROWSER=true     # open the browser on startup
